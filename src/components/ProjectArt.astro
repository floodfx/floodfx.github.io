---
// Per-project artwork dispatcher. Each project can set `artwork:`
// in its frontmatter to render a custom piece inside the gallery
// frame. If unset, falls back to the colored canvas + index number.
//
// To add new artwork:
//   1. Drop a new component in `src/components/art/`
//   2. Import it here and add a case in the switch.
//   3. Reference it by name in the project's frontmatter.

import LiveViewJSPoster from "./art/LiveViewJSPoster.astro";
import HotDogJSArt from "./art/HotDogJSArt.astro";
import GstateArt from "./art/GstateArt.astro";
import RoadBikeArt from "./art/RoadBikeArt.astro";
import GuitarLyricArt from "./art/GuitarLyricArt.astro";

interface Props {
  artwork?: string;
  index: number;
  thumbColor: "cobalt" | "coral" | "olive" | "plum" | "marigold" | "terracotta";
}

const { artwork, index, thumbColor } = Astro.props;

const thumbBgClass: Record<string, string> = {
  cobalt: "bg-cobalt",
  coral: "bg-coral",
  olive: "bg-olive",
  plum: "bg-plum",
  marigold: "bg-marigold",
  terracotta: "bg-terracotta",
};
---

{
  artwork === "liveviewjs" ? (
    <LiveViewJSPoster />
  ) : artwork === "hotdogjs" ? (
    <HotDogJSArt />
  ) : artwork === "gstate" ? (
    <GstateArt />
  ) : artwork === "roadbike" ? (
    <RoadBikeArt />
  ) : artwork === "guitar-lyric" ? (
    <GuitarLyricArt />
  ) : (
    <div class={`fallback-canvas ${thumbBgClass[thumbColor]}`}>
      <span class="fallback-num">{String(index + 1).padStart(2, "0")}</span>
    </div>
  )
}

<style>
  .fallback-canvas {
    position: absolute;
    inset: 0;
  }
  .fallback-canvas::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 25% 20%,
      rgba(255, 255, 255, 0.2),
      transparent 60%
    );
    pointer-events: none;
  }
  .fallback-num {
    position: absolute;
    right: 18px;
    bottom: 12px;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(56px, 7vw, 92px);
    line-height: 1;
    color: rgba(241, 236, 226, 0.85);
  }
</style>
