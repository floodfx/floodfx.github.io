---
import { getCollection } from "astro:content";
import { AUTHOR_NAME, SITE_TITLE, SITE_URL } from "../../consts";
import Layout from "../../layouts/Layout.astro";
import { formatDate } from "../../lib/utils";

const collection = await getCollection("posts");
const posts = collection.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const pageDescription = `Notes and essays from ${AUTHOR_NAME} — software, systems, and the occasional aside.`;

const blogLD = {
  "@context": "https://schema.org",
  "@type": "Blog",
  url: new URL("/posts", SITE_URL).toString(),
  name: `Writing · ${SITE_TITLE}`,
  description: pageDescription,
  author: {
    "@type": "Person",
    name: AUTHOR_NAME,
    url: SITE_URL,
  },
  blogPost: posts.map((p) => ({
    "@type": "BlogPosting",
    headline: p.data.title,
    description: p.data.description,
    url: new URL(`/posts/${p.id}`, SITE_URL).toString(),
    datePublished: p.data.date.toISOString(),
  })),
};
---

<Layout title="Writing" description={pageDescription}>
  <Fragment slot="head">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(blogLD)}
    />
  </Fragment>
  <section class="mx-auto max-w-[1100px] px-6 pt-20 pb-10">
    <div class="mb-12 max-w-[720px]">
      <div class="eyebrow">All writing</div>
      <h1
        class="mt-3 mb-4 text-[clamp(40px,5.5vw,72px)] leading-[1.05]"
      >
        <em class="italic text-cobalt">Thoughts</em> of the past.
      </h1>
      <p class="m-0 font-display text-[20px] italic leading-[1.4] text-fg-soft">
        At least the ones I wrote down
      </p>
    </div>

    <div class="flex flex-col border-t border-line-soft">
      {
        posts.map((post) => (
          <a
            href={`/posts/${post.id}`}
            class="post-row grid items-center gap-6 border-b border-line-soft px-3 py-6 no-underline"
            style="grid-template-columns: 140px 1fr 28px;"
          >
            <div class="font-mono text-[12px] tracking-wide text-fg-mute">
              {formatDate(post.data.date)}
            </div>
            <div>
              <h3 class="m-0 mb-1 font-display text-[22px] italic leading-[1.2]">
                {post.data.title}
              </h3>
              <p class="m-0 mb-2 text-[14px] leading-[1.5] text-fg-soft">
                {post.data.description}
              </p>
              {post.data.tags?.length > 0 && (
                <div class="flex flex-wrap gap-1.5">
                  {post.data.tags.map((t) => <span class="tag">{t}</span>)}
                </div>
              )}
            </div>
            <div class="post-arrow text-[22px] text-coral transition-transform">
              →
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  @reference "../../styles/global.css";

  .post-row {
    transition: background 0.15s, padding 0.2s;
    color: var(--fg);
  }
  .post-row:hover {
    background: var(--bg-tint);
    padding-left: 24px;
  }
  .post-row:hover .post-arrow {
    transform: translateX(4px);
  }
  @media (max-width: 700px) {
    .post-row {
      grid-template-columns: 1fr !important;
      gap: 8px !important;
    }
    .post-arrow {
      display: none;
    }
  }
</style>
