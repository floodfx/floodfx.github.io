---
import { ArtDemo } from '../components/ArtDemo';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Generative Art Demo"
  description="A demo of the GenerativeArt React component."
  className="max-w-4xl"
>
  <main class="flex flex-col items-center justify-center py-8">
    <h1 class="text-3xl font-bold mb-6">Generative Art Component</h1>
    <div class="w-full h-[500px] border border-zinc-200 dark:border-zinc-700 rounded-lg overflow-hidden shadow-sm bg-white dark:bg-zinc-800">
      <ArtDemo client:only="react" />
    </div>
    <p class="text-zinc-500 mt-4 text-center">
      Resize the window to see the component adapt.
    </p>
  </main>
</Layout>
