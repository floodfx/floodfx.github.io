---
import { ArtDemo } from "../components/ArtDemo";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Generative Art Demo"
  description="A demo of the GenerativeArt React component."
  className="max-w-4xl"
>
  <main class="flex flex-col items-center justify-center py-8">
    <h1 class="mb-6 text-3xl font-bold">Generative Art Component</h1>
    <div
      class="h-[500px] w-full overflow-hidden rounded-lg border border-zinc-200 bg-white shadow-sm dark:border-zinc-700 dark:bg-zinc-800"
    >
      <ArtDemo client:only="react" />
    </div>
    <p class="mt-4 text-center text-zinc-500">
      Resize the window to see the component adapt.
    </p>
  </main>
</Layout>
